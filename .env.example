# Prefer a single SQLAlchemy-style connection string.
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

DATABASE_URL=

# Alternative if DATABASE_URL is not provided
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Optional MLflow settings
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=brazilian-ecommerce-churn
